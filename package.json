{
  "name": "yuvraj-jarvis",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "bootstrap": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/bootstrap.ps1",
    "dev": "tauri dev",
    "verify": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/verify.ps1",
    "benchmark": "uv run python scripts/benchmark.py",
    "phone:configure": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/configure-phone.ps1",
    "package": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/package.ps1",
    "contracts": "uv run python scripts/generate_protocol.py",
    "contracts:check": "uv run python scripts/generate_protocol.py --check",
    "ui:dev": "vite --config ui/vite.config.ts",
    "ui:build": "tsc -p ui/tsconfig.json --noEmit && vite build --config ui/vite.config.ts",
    "ui:test": "vitest run --config ui/vite.config.ts",
    "e2e": "playwright test"
  },
  "dependencies": {
    "@tauri-apps/api": "2.11.1",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "qrcode": "1.5.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "workbox-window": "^7.4.1"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.7",
    "@playwright/test": "1.62.1",
    "@tauri-apps/cli": "2.11.4",
    "@testing-library/jest-dom": "7.0.0",
    "@testing-library/react": "16.3.2",
    "@types/node": "^26.2.0",
    "@types/qrcode": "1.5.6",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@vitejs/plugin-react": "6.0.5",
    "concurrently": "10.0.4",
    "jsdom": "30.0.1",
    "json-schema-to-typescript": "15.0.4",
    "typescript": "7.0.2",
    "vite": "8.2.1",
    "vite-plugin-pwa": "1.3.0",
    "vitest": "4.1.10"
  }
}
