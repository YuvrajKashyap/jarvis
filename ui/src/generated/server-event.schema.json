{
  "$defs": {
    "ApprovalRequired": {
      "additionalProperties": false,
      "properties": {
        "event_id": {
          "format": "uuid",
          "title": "Event Id",
          "type": "string"
        },
        "payload": {
          "$ref": "#/$defs/ApprovalRequiredPayload"
        },
        "sequence": {
          "minimum": 0,
          "title": "Sequence",
          "type": "integer"
        },
        "session_id": {
          "format": "uuid",
          "title": "Session Id",
          "type": "string"
        },
        "timestamp": {
          "format": "date-time",
          "title": "Timestamp",
          "type": "string"
        },
        "turn_id": {
          "format": "uuid",
          "title": "Turn Id",
          "type": "string"
        },
        "type": {
          "const": "approval_required",
          "title": "Type",
          "type": "string"
        },
        "version": {
          "const": 1,
          "title": "Version",
          "type": "integer"
        }
      },
      "required": [
        "version",
        "event_id",
        "session_id",
        "turn_id",
        "sequence",
        "timestamp",
        "type",
        "payload"
      ],
      "title": "ApprovalRequired",
      "type": "object"
    },
    "ApprovalRequiredPayload": {
      "additionalProperties": false,
      "properties": {
        "approval_id": {
          "format": "uuid",
          "title": "Approval Id",
          "type": "string"
        },
        "capability": {
          "maxLength": 160,
          "minLength": 1,
          "title": "Capability",
          "type": "string"
        },
        "expires_at": {
          "format": "date-time",
          "title": "Expires At",
          "type": "string"
        },
        "risk": {
          "enum": [
            "local_reversible",
            "external_irreversible"
          ],
          "title": "Risk",
          "type": "string"
        },
        "summary": {
          "maxLength": 1000,
          "minLength": 1,
          "title": "Summary",
          "type": "string"
        }
      },
      "required": [
        "approval_id",
        "capability",
        "summary",
        "risk",
        "expires_at"
      ],
      "title": "ApprovalRequiredPayload",
      "type": "object"
    },
